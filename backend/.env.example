# Copy to backend/.env and fill in values. Never commit real values.
# MongoDB: a real URL (e.g. a free MongoDB Atlas cluster) or, for local dev only, mongomock://local
# (in-memory fake database, resets on every restart; needs `pip install -r requirements-dev.txt`).
MONGO_URL=
DB_NAME=
# Comma-separated list of allowed browser origins, e.g. https://your-site.vercel.app
CORS_ORIGINS=
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
ADMIN_TOKEN_SECRET=
# Optional
APP_URL=
STORAGE_QUOTA_MB=2048
UPLOAD_DIR=
APP_TZ=Asia/Riyadh
# Number of trusted reverse proxies in front of the API (Render/Vercel/nginx = 1). Used for per-visitor rate limiting.
# Leave 0 when the API is reached directly; never trust X-Forwarded-For otherwise. Start uvicorn with --no-proxy-headers.
TRUSTED_PROXY_HOPS=0
