# Copy to backend/.env and fill in values. Never commit real values.
# MongoDB: a real URL (e.g. a free MongoDB Atlas cluster) or, for local dev only, mongomock://local
# (in-memory fake database, resets on every restart; needs `pip install -r requirements-dev.txt`).
MONGO_URL=
DB_NAME=
# Comma-separated list of allowed browser origins, e.g. https://your-site.vercel.app
CORS_ORIGINS=
ADMIN_PASSWORD=
# Long random string used to sign the admin session cookie, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
ADMIN_TOKEN_SECRET=
# Optional
APP_URL=
# Uploaded PDFs are stored inside MongoDB. Atlas' free tier has 512 MB in total, so keep this well below that.
STORAGE_QUOTA_MB=300
APP_TZ=Asia/Riyadh
# Per-visitor rate limiting needs the visitor's address. Start uvicorn with --no-proxy-headers, then EITHER:
#  - CLIENT_IP_HEADER=<header your trusted edge sets and overwrites>, e.g. x-vercel-forwarded-for (Vercel in front), OR
#  - TRUSTED_PROXY_HOPS=<n>: use the n-th entry from the right of X-Forwarded-For (only if the chain length is fixed).
# Leave both unset when the API is reached directly. Never trust a header a client can set itself.
CLIENT_IP_HEADER=
TRUSTED_PROXY_HOPS=0
